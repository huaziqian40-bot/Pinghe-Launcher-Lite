<?xml version="1.0" encoding="UTF-8"?>
<!--
  SchoolHub Windows 安装包 (WiX 3.x)
  - 按用户安装 (perUser): 装到 %LocalAppData%\Programs\SchoolHub, 无需管理员权限
  - 带开始菜单快捷方式, 支持在"应用和功能"里正常卸载与升级
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="SchoolHub"
           Language="2052"
           Codepage="936"
           Version="1.0.0.0"
           Manufacturer="SchoolHub"
           UpgradeCode="67aed5b4-b73a-453f-9506-b62a9ed7b642">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perUser"
             Platform="x64"
             Description="SchoolHub 学习助手"
             Comments="本地运行, 数据不出机器" />

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 SchoolHub, 如需重装请先卸载。" />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <!-- 主程序: %LocalAppData%\Programs\SchoolHub\SchoolHub.exe -->
      <Directory Id="LocalAppDataFolder">
        <Directory Id="AppProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="SchoolHub">
            <Component Id="MainExecutable" Guid="e07340ef-0f63-476f-8542-703422883f3d" Win64="yes">
              <File Id="SchoolHubExe"
                    Source="..\dist\SchoolHub.exe"
                    Checksum="yes" />
              <RemoveFolder Id="RemoveAppProgramsFolder" Directory="AppProgramsFolder" On="uninstall" />
              <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
              <RegistryValue Root="HKCU"
                             Key="Software\SchoolHub"
                             Name="exe_installed"
                             Type="integer"
                             Value="1"
                             KeyPath="yes" />
            </Component>
          </Directory>
        </Directory>
      </Directory>

      <!-- 开始菜单: SchoolHub \ SchoolHub -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="SchoolHubMenuDir" Name="SchoolHub">
          <Component Id="StartMenuShortcut" Guid="33d7a6ba-2a29-4ff4-bff0-9ebebf78a8ba">
            <Shortcut Id="SchoolHubShortcut"
                      Name="SchoolHub"
                      Description="SchoolHub 学习助手"
                      Target="[INSTALLFOLDER]SchoolHub.exe"
                      WorkingDirectory="INSTALLFOLDER" />
            <RemoveFolder Id="RemoveSchoolHubMenuDir" On="uninstall" />
            <RegistryValue Root="HKCU"
                           Key="Software\SchoolHub"
                           Name="installed"
                           Type="integer"
                           Value="1"
                           KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="SchoolHub" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <Property Id="ARPPRODUCTICON" Value="SchoolHubExe" />
    <Icon Id="SchoolHubExe" SourceFile="..\dist\SchoolHub.exe" />
  </Product>
</Wix>
